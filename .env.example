# Server Config
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Owner Identity (verified on every protected request)
OWNER_ID=your-owner-uuid
OWNER_EMAIL=sebastian@example.com

# Supabase (Memory & Task Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# n8n Orchestration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_AUTH_TOKEN=optional-bearer-token

# AI Brain (OpenAI or compatible)
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4
AI_BASE_URL=https://api.openai.com/v1

# Logging
LOG_LEVEL=debug
